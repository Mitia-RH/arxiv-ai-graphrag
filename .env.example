# Copy this file to ".env" and update the values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123   # At least 8 characters (Neo4j requirement).

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text     # Ollama embedding model for hybrid vector retrieval (768 dimensions).

MAX_PAPERS=100               # Number of papers to ingest by default.
OPENALEX_EMAIL=              # Optional: your email; OpenAlex responds faster ("polite pool").
# Full-text, property, and vector indexes are created by the app/ingestion schema setup.
# The Graph Data Science plugin is configured by docker-compose.yml; no extra setting is needed.
